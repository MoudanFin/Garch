"""
MASI Index GARCH Analysis, Backtesting, and VaR Calculation
This script performs:
1. Data simulation for MASI index (2020-2025)
2. Returns calculation
3. GARCH(1,1) model fitting from scratch
4. Rolling window backtesting
5. Forecast comparison with actual values
6. Value at Risk (VaR) calculation

Note: This is a standalone implementation of GARCH without external dependencies
"""

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy import stats
from scipy.optimize import minimize
import warnings
warnings.filterwarnings('ignore')

# Set style
try:
    plt.style.use('seaborn-v0_8-darkgrid')
except:
    plt.style.use('default')


class GARCH11:
    """
    GARCH(1,1) model implementation from scratch
    σ²_t = ω + α*ε²_{t-1} + β*σ²_{t-1}
    """
    
    def __init__(self, returns):
        self.returns = np.array(returns)
        self.n = len(self.returns)
        self.params = None
        self.conditional_volatility = None
        self.std_resid = None
        self.loglikelihood = None
        self.aic = None
        self.bic = None
        
    def _garch_likelihood(self, params):
        """Calculate negative log-likelihood for GARCH(1,1)"""
        omega, alpha, beta = params
        
        # Constraints check
        if omega <= 0 or alpha < 0 or beta < 0 or (alpha + beta) >= 1:
            return 1e10
        
        # Initialize variance with sample variance
        sigma2 = np.zeros(self.n)
        sigma2[0] = np.var(self.returns)
        
        # Calculate conditional variance
        for t in range(1, self.n):
            sigma2[t] = omega + alpha * self.returns[t-1]**2 + beta * sigma2[t-1]
            
            # Ensure positive variance
            if sigma2[t] <= 0:
                return 1e10
        
        # Calculate log-likelihood
        loglik = -0.5 * np.sum(np.log(2 * np.pi * sigma2) + self.returns**2 / sigma2)
        
        return -loglik  # Return negative for minimization
    
    def fit(self):
        """Fit GARCH(1,1) model using maximum likelihood estimation"""
        # Initial parameter values
        initial_params = [0.01, 0.1, 0.85]
        
        # Bounds for parameters
        bounds = [(1e-6, 1), (0, 1), (0, 1)]
        
        # Constraints: alpha + beta < 1
        constraints = {'type': 'ineq', 'fun': lambda x: 0.9999 - (x[1] + x[2])}
        
        # Optimize
        result = minimize(
            self._garch_likelihood,
            initial_params,
            method='SLSQP',
            bounds=bounds,
            constraints=constraints,
            options={'maxiter': 1000}
        )
        
        if not result.success:
            print(f"Warning: Optimization did not converge: {result.message}")
        
        self.params = result.x
        omega, alpha, beta = self.params
        
        # Calculate fitted conditional volatility
        sigma2 = np.zeros(self.n)
        sigma2[0] = np.var(self.returns)
        
        for t in range(1, self.n):
            sigma2[t] = omega + alpha * self.returns[t-1]**2 + beta * sigma2[t-1]
        
        self.conditional_volatility = np.sqrt(sigma2)
        self.std_resid = self.returns / self.conditional_volatility
        
        # Calculate information criteria
        self.loglikelihood = -result.fun
        k = 3  # number of parameters
        self.aic = 2 * k - 2 * self.loglikelihood
        self.bic = k * np.log(self.n) - 2 * self.loglikelihood
        
        return self
    
    def forecast(self, horizon=1):
        """Forecast volatility h-steps ahead"""
        omega, alpha, beta = self.params
        
        # Last conditional variance
        last_variance = self.conditional_volatility[-1]**2
        last_return = self.returns[-1]
        
        forecasts = np.zeros(horizon)
        
        # Multi-step forecast
        current_variance = omega + alpha * last_return**2 + beta * last_variance
        forecasts[0] = current_variance
        
        for h in range(1, horizon):
            current_variance = omega + (alpha + beta) * current_variance
            forecasts[h] = current_variance
        
        return np.sqrt(forecasts)
    
    def summary(self):
        """Return model summary as string"""
        omega, alpha, beta = self.params
        persistence = alpha + beta
        unconditional_vol = np.sqrt(omega / (1 - persistence))
        
        summary = f"""
{'='*70}
                    GARCH(1,1) Model Results
{'='*70}

Parameters:
  ω (omega):        {omega:.6f}
  α (alpha):        {alpha:.6f}
  β (beta):         {beta:.6f}

Statistics:
  α + β:            {persistence:.6f}  (Persistence)
  Unconditional σ:  {unconditional_vol:.6f}
  
Model Fit:
  Log-Likelihood:   {self.loglikelihood:.2f}
  AIC:              {self.aic:.2f}
  BIC:              {self.bic:.2f}

Interpretation:
  - High persistence (α+β ≈ {persistence:.3f}) indicates volatility clustering
  - α measures shock impact, β measures volatility persistence
  - Unconditional volatility: {unconditional_vol:.4f}%

{'='*70}
"""
        return summary

class MASIGARCHAnalysis:
    """Class to perform GARCH analysis on MASI index"""
    
    def __init__(self, start_date='2020-01-01', end_date='2025-12-31'):
        self.start_date = start_date
        self.end_date = end_date
        self.data = None
        self.returns = None
        self.best_model = None
        self.best_model_name = "GARCH(1,1)"
        self.forecasts = None
        self.var_results = None
        
    def generate_masi_data(self):
        """Generate realistic MASI-like index data"""
        print("Generating MASI index data...")
        np.random.seed(42)
        
        date_range = pd.date_range(start=self.start_date, end=self.end_date, freq='D')
        n = len(date_range)
        
        # Simulate realistic MASI index with GARCH characteristics
        # MASI typically shows volatility clustering
        
        # Generate returns with GARCH structure
        omega, alpha, beta = 0.00001, 0.1, 0.85  # True GARCH parameters
        
        returns = np.zeros(n)
        sigma2 = np.zeros(n)
        sigma2[0] = 0.0002  # Initial variance
        
        for t in range(n):
            # GARCH variance
            if t > 0:
                sigma2[t] = omega + alpha * returns[t-1]**2 + beta * sigma2[t-1]
            
            # Return with conditional volatility
            returns[t] = np.random.normal(0.0005, np.sqrt(sigma2[t]))
            
            # Add occasional jumps for realism
            if np.random.random() < 0.02:  # 2% chance of jump
                returns[t] += np.random.choice([-1, 1]) * np.random.uniform(0.02, 0.04)
        
        # Convert to price levels
        prices = 100 * np.exp(np.cumsum(returns))
        
        # Create realistic OHLCV data
        self.data = pd.DataFrame({
            'Open': prices * np.random.uniform(0.995, 1.000, n),
            'High': prices * np.random.uniform(1.000, 1.015, n),
            'Low': prices * np.random.uniform(0.985, 1.000, n),
            'Close': prices,
            'Adj Close': prices,
            'Volume': np.random.lognormal(14, 0.5, n).astype(int)
        }, index=date_range)
        
        # Ensure High >= Close >= Low and Open
        self.data['High'] = self.data[['Open', 'High', 'Close']].max(axis=1)
        self.data['Low'] = self.data[['Open', 'Low', 'Close']].min(axis=1)
        
        print(f"Generated {len(self.data)} data points")
        print(f"Date range: {self.data.index[0].date()} to {self.data.index[-1].date()}")
        print(f"Price range: {self.data['Close'].min():.2f} to {self.data['Close'].max():.2f}")
        
        return self.data
    
    def calculate_returns(self):
        """Calculate log returns"""
        print("\nCalculating returns...")
        self.returns = 100 * np.log(self.data['Close'] / self.data['Close'].shift(1))
        self.returns = self.returns.dropna()
        
        print(f"Returns statistics:")
        print(f"  Mean: {self.returns.mean():.6f}%")
        print(f"  Std Dev: {self.returns.std():.4f}%")
        print(f"  Min: {self.returns.min():.4f}%")
        print(f"  Max: {self.returns.max():.4f}%")
        print(f"  Skewness: {self.returns.skew():.4f}")
        print(f"  Kurtosis: {self.returns.kurtosis():.4f}")
        
        return self.returns
    
    def test_arch_effect(self):
        """Test for ARCH effects using Ljung-Box test on squared returns"""
        print("\n" + "="*60)
        print("Testing for ARCH Effects")
        print("="*60)
        
        # Manual Ljung-Box test on squared returns
        squared_returns = (self.returns ** 2).values
        n = len(squared_returns)
        
        # Calculate autocorrelations
        mean_sq = np.mean(squared_returns)
        sq_centered = squared_returns - mean_sq
        
        lags = 10
        autocorrs = []
        
        for lag in range(1, lags + 1):
            r = np.corrcoef(squared_returns[:-lag], squared_returns[lag:])[0, 1]
            autocorrs.append(r)
        
        # Ljung-Box statistic
        lb_stat = n * (n + 2) * np.sum([(autocorrs[i]**2) / (n - i - 1) 
                                         for i in range(lags)])
        
        # Chi-square test
        p_value = 1 - stats.chi2.cdf(lb_stat, lags)
        
        print(f"\nLjung-Box Test on Squared Returns (lag={lags}):")
        print(f"  Test Statistic: {lb_stat:.4f}")
        print(f"  P-value: {p_value:.6f}")
        
        if p_value < 0.05:
            print("\n✓ ARCH effects detected (p-value < 0.05)")
            print("  GARCH modeling is appropriate")
        else:
            print("\n✗ No significant ARCH effects detected")
            print("  But GARCH modeling may still capture volatility dynamics")
        
        # Show first 5 autocorrelations
        print(f"\nAutocorrelations of squared returns:")
        for i, ac in enumerate(autocorrs[:5], 1):
            print(f"  Lag {i}: {ac:.4f}")
    
    def fit_garch_models(self):
        """Fit GARCH(1,1) model"""
        print("\n" + "="*60)
        print("Fitting GARCH(1,1) Model")
        print("="*60)
        
        print("\nEstimating parameters via maximum likelihood...")
        
        # Fit GARCH(1,1) model
        self.best_model = GARCH11(self.returns.values)
        self.best_model.fit()
        
        print("\n" + "="*60)
        print("GARCH Model Summary")
        print("="*60)
        print(self.best_model.summary())
        
        return self.best_model
    
    def rolling_window_backtest(self, train_size=0.7, window_size=252):
        """
        Perform rolling window backtesting
        
        Parameters:
        - train_size: proportion of data for initial training
        - window_size: size of rolling window in days (252 = 1 year)
        """
        print("\n" + "="*60)
        print("Rolling Window Backtesting")
        print("="*60)
        
        # Split data
        returns_array = self.returns.values
        n = len(returns_array)
        split_point = int(n * train_size)
        
        print(f"\nTotal observations: {n}")
        print(f"Training period: {split_point} observations")
        print(f"  From: {self.returns.index[0].date()}")
        print(f"  To: {self.returns.index[split_point-1].date()}")
        print(f"Testing period: {n - split_point} observations")
        print(f"  From: {self.returns.index[split_point].date()}")
        print(f"  To: {self.returns.index[-1].date()}")
        print(f"Window size: {window_size} days")
        
        forecasts = []
        realized_vol = []
        dates = []
        
        # Rolling window forecast
        print("\nPerforming rolling window forecasts...")
        total_forecasts = n - split_point
        
        for i in range(split_point, n):
            # Use rolling window
            start_idx = max(0, i - window_size)
            train_data = returns_array[start_idx:i]
            
            try:
                # Fit GARCH model on rolling window
                model = GARCH11(train_data)
                model.fit()
                
                # Forecast one step ahead
                forecast_vol = model.forecast(horizon=1)[0]
                forecasts.append(forecast_vol)
                
                # Realized volatility (absolute return as proxy)
                realized_vol.append(abs(returns_array[i]))
                dates.append(self.returns.index[i])
                
                if (i - split_point + 1) % 100 == 0:
                    pct_complete = ((i - split_point + 1) / total_forecasts) * 100
                    print(f"  Progress: {i - split_point + 1}/{total_forecasts} " +
                          f"forecasts ({pct_complete:.1f}%)")
                    
            except Exception as e:
                print(f"  Warning: Forecast failed at index {i}: {e}")
                # Use last valid forecast or skip
                if len(forecasts) > 0:
                    forecasts.append(forecasts[-1])
                    realized_vol.append(abs(returns_array[i]))
                    dates.append(self.returns.index[i])
                continue
        
        self.forecasts = pd.DataFrame({
            'Date': dates,
            'Forecast_Volatility': forecasts,
            'Realized_Volatility': realized_vol
        })
        self.forecasts.set_index('Date', inplace=True)
        
        print(f"\n✓ Completed {len(forecasts)} forecasts")
        
        # Calculate forecast metrics
        self._evaluate_forecasts()
        
        return self.forecasts
    
    def _evaluate_forecasts(self):
        """Evaluate forecast accuracy"""
        print("\n" + "="*60)
        print("Forecast Evaluation Metrics")
        print("="*60)
        
        y_true = self.forecasts['Realized_Volatility'].values
        y_pred = self.forecasts['Forecast_Volatility'].values
        
        # Calculate metrics
        mae = np.mean(np.abs(y_true - y_pred))
        mse = np.mean((y_true - y_pred) ** 2)
        rmse = np.sqrt(mse)
        
        # Avoid division by zero in MAPE
        mask = y_true != 0
        mape = np.mean(np.abs((y_true[mask] - y_pred[mask]) / y_true[mask])) * 100 if mask.any() else np.nan
        
        # Correlation
        correlation = np.corrcoef(y_true, y_pred)[0, 1]
        
        print(f"\nMean Absolute Error (MAE): {mae:.4f}")
        print(f"Root Mean Squared Error (RMSE): {rmse:.4f}")
        if not np.isnan(mape):
            print(f"Mean Absolute Percentage Error (MAPE): {mape:.2f}%")
        print(f"Correlation: {correlation:.4f}")
        
        # Directional accuracy
        y_true_mean = np.mean(y_true)
        y_pred_mean = np.mean(y_pred)
        y_true_binary = (y_true > y_true_mean).astype(int)
        y_pred_binary = (y_pred > y_pred_mean).astype(int)
        directional_accuracy = np.mean(y_true_binary == y_pred_binary) * 100
        
        print(f"Directional Accuracy: {directional_accuracy:.2f}%")
        
        # R-squared
        ss_res = np.sum((y_true - y_pred) ** 2)
        ss_tot = np.sum((y_true - np.mean(y_true)) ** 2)
        r2 = 1 - (ss_res / ss_tot) if ss_tot != 0 else 0
        print(f"R-squared: {r2:.4f}")
    
    def calculate_var(self, confidence_levels=[0.95, 0.99], horizon=1):
        """
        Calculate Value at Risk (VaR) using GARCH forecasts
        
        Parameters:
        - confidence_levels: list of confidence levels
        - horizon: forecast horizon in days
        """
        print("\n" + "="*60)
        print("Value at Risk (VaR) Calculation")
        print("="*60)
        
        # Get final forecast from the fitted model
        forecast_volatility = self.best_model.forecast(horizon=horizon)
        forecast_variance = forecast_volatility ** 2
        
        # Current portfolio value (assuming $1M for demonstration)
        portfolio_value = 1_000_000
        
        # Mean return (can be set to 0 for conservative estimate)
        mean_return = self.returns.mean() / 100  # Convert to decimal
        
        # Calculate VaR for different confidence levels
        var_results = []
        
        print(f"\nPortfolio Value: ${portfolio_value:,.2f}")
        print(f"Forecast Horizon: {horizon} day(s)")
        print(f"Mean Daily Return: {mean_return*100:.4f}%")
        
        for h in range(horizon):
            print(f"\n  Forecast volatility (day {h+1}): {forecast_volatility[h]:.4f}%")
        
        print("\n" + "-"*80)
        
        for conf_level in confidence_levels:
            alpha = 1 - conf_level
            
            # Using normal distribution (assuming standardized returns)
            z_score = stats.norm.ppf(alpha)
            
            # VaR formula: VaR = -(μ + σ * z_α)
            # For multi-day horizon, scale by sqrt(horizon)
            horizon_volatility = forecast_volatility[-1] / 100  # Last forecast, convert to decimal
            
            # Portfolio return = mean_return * horizon + volatility * sqrt(horizon) * z_score
            portfolio_return = mean_return * horizon + horizon_volatility * np.sqrt(horizon) * z_score
            var_pct = -portfolio_return  # VaR is negative of return
            var_amount = portfolio_value * var_pct
            
            var_results.append({
                'Confidence_Level': f"{conf_level*100}%",
                'Alpha': f"{alpha:.4f}",
                'Z_Score': f"{z_score:.4f}",
                'VaR_Percentage': f"{var_pct*100:.2f}%",
                'VaR_Amount': f"${abs(var_amount):,.2f}",
                'Interpretation': f"Loss won't exceed this with {conf_level*100}% confidence"
            })
        
        self.var_results = pd.DataFrame(var_results)
        
        print(self.var_results.to_string(index=False))
        print("-"*80)
        
        # Conditional VaR (Expected Shortfall / CVaR)
        print("\n" + "="*60)
        print("Conditional VaR (Expected Shortfall / CVaR)")
        print("="*60)
        print("\nCVaR represents the expected loss given that VaR has been exceeded")
        
        for conf_level in confidence_levels:
            alpha = 1 - conf_level
            z_score = stats.norm.ppf(alpha)
            
            # CVaR formula for normal distribution: CVaR = μ - σ * φ(z_α) / α
            # where φ is the PDF of standard normal
            horizon_volatility = forecast_volatility[-1] / 100
            
            phi_z = stats.norm.pdf(z_score)
            cvar_return = mean_return * horizon - horizon_volatility * np.sqrt(horizon) * (phi_z / alpha)
            cvar_pct = -cvar_return
            cvar_amount = portfolio_value * cvar_pct
            
            print(f"\n{conf_level*100}% CVaR:")
            print(f"  Percentage: {cvar_pct*100:.2f}%")
            print(f"  Amount: ${abs(cvar_amount):,.2f}")
            print(f"  Interpretation: Expected loss if loss exceeds {conf_level*100}% VaR")
        
        # Additional risk metrics
        print("\n" + "="*60)
        print("Additional Risk Metrics")
        print("="*60)
        
        # Maximum drawdown estimate
        max_1day_loss = portfolio_value * (mean_return - 3 * forecast_volatility[-1]/100)
        print(f"\nEstimated Maximum 1-day Loss (3σ event): ${abs(max_1day_loss):,.2f}")
        
        # Annual VaR (scaling to 252 trading days)
        annual_vol = forecast_volatility[-1] * np.sqrt(252) / 100
        annual_var_95 = portfolio_value * (mean_return * 252 - stats.norm.ppf(0.05) * annual_vol)
        print(f"Estimated Annual VaR (95%): ${abs(annual_var_95):,.2f}")
        
        return self.var_results
    
